# 生产环境模板：复制为 deploy/.env 后填写，禁止提交真实密钥。
# 推荐由 Caddy/Nginx 对外提供 HTTPS，因此应用只监听本机回环地址。
BIND_HOST=127.0.0.1
SERVER_PORT=8080
TZ=Asia/Shanghai

# 数据库、Redis 和管理员初始密码必须使用随机长字符串。
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_SECRET
REDIS_PASSWORD=CHANGE_ME_TO_A_RANDOM_SECRET
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_RANDOM_SECRET

# 这两个值一旦上线不要随意更换，否则会导致已有会话或 TOTP 失效。
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
TOTP_ENCRYPTION_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# 只允许实际使用的上游域名；不确定时先保持关闭并通过网关白名单控制。
SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false
# SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=api.openai.com,api.anthropic.com,api.x.ai

# 生成随机值示例：每条命令输出一串值，分别填入上面的 CHANGE_ME。
# openssl rand -hex 32
